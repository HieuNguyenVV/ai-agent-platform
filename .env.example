# Application Configuration
APP_ENV=development
APP_PORT=8080
APP_HOST=localhost
APP_DEBUG=true
APP_API_VERSION=v1
APP_API_PREFIX=/api

# Logging Configuration
LOG_LEVEL=info

# Postgres Configuration
POSTGRES_MASTER_HOST=postgres
POSTGRES_MASTER_PORT=5432
POSTGRES_MASTER_USER=ai-agent
POSTGRES_MASTER_PASSWORD=ai-agent
POSTGRES_MASTER_DATABASE=ai-agent-db
POSTGRES_MASTER_SSL_MODE=disable
POSTGRES_MASTER_MAX_OPEN_CONNS=10
POSTGRES_MASTER_MAX_IDLE_CONNS=5

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_ACCESS_TOKEN_SECRET=ai-agent-secret
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
